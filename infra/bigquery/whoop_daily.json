[
  {"name": "user_id",                     "type": "STRING",    "mode": "REQUIRED", "description": "Which person this day belongs to"},
  {"name": "date",                        "type": "DATE",      "mode": "REQUIRED", "description": "Calendar date (local), derived from the cycle's start"},
  {"name": "cycle_id",                    "type": "INTEGER",   "mode": "REQUIRED", "description": "WHOOP's physiological cycle id; idempotency key alongside user_id"},
  {"name": "cycle_start",                 "type": "TIMESTAMP", "mode": "NULLABLE"},
  {"name": "cycle_end",                   "type": "TIMESTAMP", "mode": "NULLABLE", "description": "NULL while the cycle is still open (today)"},
  {"name": "day_strain",                  "type": "FLOAT",     "mode": "NULLABLE", "description": "Cycle score.strain"},
  {"name": "day_kilojoule",               "type": "FLOAT",     "mode": "NULLABLE"},
  {"name": "day_avg_hr",                  "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "day_max_hr",                  "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "step_count",                  "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "recovery_score",              "type": "INTEGER",   "mode": "NULLABLE", "description": "NULL when this cycle has no scored recovery yet"},
  {"name": "hrv_rmssd_milli",             "type": "FLOAT",     "mode": "NULLABLE"},
  {"name": "resting_hr",                  "type": "INTEGER",   "mode": "NULLABLE", "description": "From the Recovery object, not the Cycle object"},
  {"name": "spo2_percentage",             "type": "FLOAT",     "mode": "NULLABLE"},
  {"name": "skin_temp_celsius",           "type": "FLOAT",     "mode": "NULLABLE"},
  {"name": "respiratory_rate",            "type": "FLOAT",     "mode": "NULLABLE", "description": "From the night's main Sleep object"},
  {"name": "sleep_performance_percentage","type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "sleep_efficiency_percentage", "type": "FLOAT",     "mode": "NULLABLE"},
  {"name": "deep_sleep_seconds",          "type": "INTEGER",   "mode": "NULLABLE", "description": "stage_summary.total_slow_wave_sleep_time_milli / 1000"},
  {"name": "rem_sleep_seconds",           "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "light_sleep_seconds",         "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "awake_seconds",               "type": "INTEGER",   "mode": "NULLABLE"},
  {"name": "ingested_ts",                 "type": "TIMESTAMP", "mode": "NULLABLE", "description": "When the pipeline stored this row"},
  {"name": "raw",                         "type": "JSON",      "mode": "NULLABLE", "description": "Full cycle + recovery + sleep payloads for this day, lossless"}
]
